{
  "info": {
    "name": "fintech-fineract-assessment",
    "description": "Run in order: Mock ERP > Create account, then Integration Service > Sync GL accounts. Fineract uses a self-signed certificate: turn off SSL certificate verification in Postman settings for the Fineract requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "erp_url", "value": "http://localhost:8001" },
    { "key": "integration_url", "value": "http://localhost:8000" },
    { "key": "fineract_url", "value": "https://localhost:8443/fineract-provider/api/v1" },
    { "key": "fineract_tenant", "value": "default" },
    { "key": "fineract_username", "value": "mifos" },
    { "key": "fineract_password", "value": "password" },
    { "key": "gl_reference", "value": "GL-1200" },
    { "key": "gl_sync_reference", "value": "POSTMAN-GL-SYNC-1" },
    { "key": "journal_reference", "value": "POSTMAN-JE-1" },
    { "key": "partner_api_key", "value": "change-me-partner-key" },
    { "key": "admin_api_key", "value": "change-me-admin-key" }
  ],
  "item": [
    {
      "name": "Mock ERP",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{erp_url}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"1200\",\n  \"name\": \"Loan Receivable\",\n  \"type\": \"ASSET\",\n  \"currency\": \"RWF\",\n  \"external_reference\": \"{{gl_reference}}\"\n}"
            },
            "description": "The ERP seeds GL-1200 at startup, so this returns 200 with the existing account. 201 for a new account, 409 when the reference or code is reused with different details."
          }
        },
        {
          "name": "Create account (conflicting payload)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{erp_url}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"1200\",\n  \"name\": \"Loans Receivable (renamed)\",\n  \"type\": \"ASSET\",\n  \"currency\": \"RWF\",\n  \"external_reference\": \"{{gl_reference}}\"\n}"
            },
            "description": "Expected 409 after 'Create account' has run."
          }
        },
        {
          "name": "List accounts",
          "request": { "method": "GET", "url": "{{erp_url}}/api/accounts" }
        },
        {
          "name": "Get account",
          "request": { "method": "GET", "url": "{{erp_url}}/api/accounts/{{gl_reference}}" }
        },
        {
          "name": "Account balance",
          "request": { "method": "GET", "url": "{{erp_url}}/api/accounts/1200/balance" }
        },
        {
          "name": "Post journal entry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{erp_url}}/api/journal-entries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{journal_reference}}\",\n  \"entry_date\": \"2026-10-30\",\n  \"description\": \"Example transfer\",\n  \"currency\": \"RWF\",\n  \"lines\": [\n    { \"account_code\": \"1300\", \"debit\": 250000 },\n    { \"account_code\": \"1100\", \"credit\": 250000 }\n  ]\n}"
            },
            "description": "201 when new, 200 with the stored entry when sent again unchanged, 409 when the reference is reused with different details. Posts to real accounts: use a scratch stack."
          }
        },
        {
          "name": "Post journal entry (unbalanced)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{erp_url}}/api/journal-entries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{journal_reference}}-UNBALANCED\",\n  \"entry_date\": \"2026-10-30\",\n  \"description\": \"Example transfer\",\n  \"currency\": \"RWF\",\n  \"lines\": [\n    { \"account_code\": \"1300\", \"debit\": 250000 },\n    { \"account_code\": \"1100\", \"credit\": 249999 }\n  ]\n}"
            },
            "description": "Expected 422; nothing is stored."
          }
        },
        {
          "name": "Get journal entry",
          "request": { "method": "GET", "url": "{{erp_url}}/api/journal-entries/{{journal_reference}}" }
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{erp_url}}/health" }
        }
      ]
    },
    {
      "name": "Integration Service",
      "description": "Every route except /health needs X-API-Key: partner_api_key for /api, admin_api_key for /admin (PARTNER_API_KEY and ADMIN_API_KEY in .env).",
      "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-API-Key" }, { "key": "value", "value": "{{partner_api_key}}" }, { "key": "in", "value": "header" }] },
      "item": [
        {
          "name": "Sync GL accounts",
          "request": {
            "method": "POST",
            "url": "{{integration_url}}/api/gl-accounts/sync",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"external_reference\": \"{{gl_sync_reference}}\"\n}" },
            "description": "Reads every ERP account and creates the missing GL accounts in Fineract. One sync per external_reference: the same reference returns 200 with the original result, or 202 while it is still running. Returns the sync status of each account."
          }
        },
        {
          "name": "List GL sync statuses",
          "request": { "method": "GET", "url": "{{integration_url}}/api/gl-accounts" }
        },
        {
          "name": "Run recovery sweep",
          "request": {
            "method": "POST",
            "url": "{{integration_url}}/admin/recover",
            "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-API-Key" }, { "key": "value", "value": "{{admin_api_key}}" }, { "key": "in", "value": "header" }] },
            "description": "Retries GL accounts left in SYNC_PENDING whose next attempt is due. Also runs on startup and every 30 seconds."
          }
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{integration_url}}/health", "auth": { "type": "noauth" } }
        }
      ]
    },
    {
      "name": "Fineract (direct, for checking)",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "{{fineract_username}}" },
          { "key": "password", "value": "{{fineract_password}}" }
        ]
      },
      "item": [
        {
          "name": "Get GL account by external reference",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{fineract_tenant}}" }],
            "url": "{{fineract_url}}/glaccounts/external-reference/{{gl_reference}}"
          }
        },
        {
          "name": "List GL accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{fineract_tenant}}" }],
            "url": "{{fineract_url}}/glaccounts"
          }
        },
        {
          "name": "Sync GL account (patched endpoint)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{fineract_tenant}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{fineract_url}}/glaccounts/sync",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalReference\": \"{{gl_reference}}\",\n  \"glCode\": \"1200\",\n  \"name\": \"Loan Receivable\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true\n}"
            },
            "description": "Called by the integration service. Same reference and payload returns the existing account; a different payload returns 409."
          }
        }
      ]
    }
  ]
}
