+package org.apache.fineract.integrationtests.accounting;
+
+import static org.apache.fineract.client.feign.util.FeignCalls.fail;
+import static org.apache.fineract.client.feign.util.FeignCalls.ok;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import org.apache.fineract.accounting.glaccount.domain.GLAccountType;
+import org.apache.fineract.client.feign.FineractFeignClient;
+import org.apache.fineract.client.feign.util.CallFailedRuntimeException;
+import org.apache.fineract.client.models.GetGLAccountsResponse;
+import org.apache.fineract.client.models.PostGLAccountsResponse;
+import org.apache.fineract.client.models.PostGLAccountsSyncRequest;
+import org.apache.fineract.integrationtests.client.feign.helpers.FeignRoleHelper;
+import org.apache.fineract.integrationtests.client.feign.helpers.FeignUserHelper;
+import org.apache.fineract.integrationtests.common.FineractFeignClientHelper;
+import org.apache.fineract.integrationtests.common.Utils;
+import org.junit.jupiter.api.Test;
+
+public class GLAccountExternalReferenceIntegrationTest {
+
+    private static final String PASSWORD = "QwE!5rTy#9uP0";
+
+    private final FineractFeignClient admin = FineractFeignClientHelper.getFineractFeignClient();
+
+    @Test
+    public void identicalSyncReturnsTheSameAccount() {
+        final String reference = uniqueReference();
+        final String glCode = uniqueGlCode();
+        final PostGLAccountsSyncRequest request = syncRequest(reference, glCode, "Loan Receivable");
+
+        final PostGLAccountsResponse first = sync(admin, request);
+        final PostGLAccountsResponse second = sync(admin, request);
+
+        assertEquals(first.getResourceId(), second.getResourceId());
+        final GetGLAccountsResponse stored = getByReference(reference);
+        assertEquals(first.getResourceId(), stored.getId());
+        assertEquals(reference, stored.getExternalReference());
+        assertEquals(glCode, stored.getGlCode());
+    }
+
+    @Test
+    public void sameReferenceWithDifferentPayloadIsRejectedWithConflict() {
+        final String reference = uniqueReference();
+        final String glCode = uniqueGlCode();
+        sync(admin, syncRequest(reference, glCode, "Loan Receivable"));
+
+        final CallFailedRuntimeException conflict = fail(
+                () -> admin.generalLedgerAccount().syncGLAccount(syncRequest(reference, glCode, "Loans Receivable")));
+
+        assertEquals(409, conflict.getStatus());
+        assertEquals("error.msg.glaccount.external.reference.conflict", conflict.getUserMessageGlobalisationCode());
+        assertEquals("Loan Receivable", getByReference(reference).getName());
+    }
+
+    @Test
+    public void glCodeUsedByAnotherAccountIsRejectedWithConflict() {
+        final String glCode = uniqueGlCode();
+        sync(admin, syncRequest(uniqueReference(), glCode, "Loan Receivable"));
+        final String otherReference = uniqueReference();
+
+        final CallFailedRuntimeException conflict = fail(
+                () -> admin.generalLedgerAccount().syncGLAccount(syncRequest(otherReference, glCode, "Loan Receivable")));
+
+        assertEquals(409, conflict.getStatus());
+        assertEquals("error.msg.glaccount.glcode.conflict", conflict.getUserMessageGlobalisationCode());
+        assertEquals(404, fail(() -> admin.generalLedgerAccount().retrieveGLAccountByExternalReference(otherReference)).getStatus());
+    }
+
+    @Test
+    public void concurrentIdenticalSyncsCreateOneAccount() throws Exception {
+        final String reference = uniqueReference();
+        final PostGLAccountsSyncRequest request = syncRequest(reference, uniqueGlCode(), "Loan Receivable");
+        final int requests = 8;
+        final ExecutorService executor = Executors.newFixedThreadPool(requests);
+        final CountDownLatch start = new CountDownLatch(1);
+        final List<Future<PostGLAccountsResponse>> futures = new ArrayList<>();
+        try {
+            for (int i = 0; i < requests; i++) {
+                futures.add(executor.submit(() -> {
+                    start.await();
+                    return sync(admin, request);
+                }));
+            }
+            start.countDown();
+
+            final Set<Long> accountIds = new HashSet<>();
+            for (Future<PostGLAccountsResponse> future : futures) {
+                accountIds.add(future.get().getResourceId());
+            }
+            assertEquals(1, accountIds.size(), "all concurrent syncs must return the same account");
+            assertEquals(accountIds.iterator().next(), getByReference(reference).getId());
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    public void syncRequiresSyncPermission() {
+        final Long roleId = FeignRoleHelper.createRole();
+        FeignRoleHelper.addPermissionsToRole(roleId, Map.of("READ_GLACCOUNT", true, "CREATE_GLACCOUNT", true));
+        final FineractFeignClient user = userWithRole(roleId);
+
+        final CallFailedRuntimeException denied = fail(
+                () -> user.generalLedgerAccount().syncGLAccount(syncRequest(uniqueReference(), uniqueGlCode(), "Loan Receivable")));
+        assertEquals(403, denied.getStatus());
+
+        FeignRoleHelper.addPermissionsToRole(roleId, Map.of("SYNC_GLACCOUNT", true));
+        assertNotNull(sync(user, syncRequest(uniqueReference(), uniqueGlCode(), "Loan Receivable")).getResourceId());
+    }
+
+    private static PostGLAccountsResponse sync(final FineractFeignClient client, final PostGLAccountsSyncRequest request) {
+        return ok(() -> client.generalLedgerAccount().syncGLAccount(request));
+    }
+
+    private GetGLAccountsResponse getByReference(final String reference) {
+        return ok(() -> admin.generalLedgerAccount().retrieveGLAccountByExternalReference(reference));
+    }
+
+    private static FineractFeignClient userWithRole(final Long roleId) {
+        final String username = Utils.uniqueRandomStringGenerator("glsync", 6);
+        FeignUserHelper.createUser(FeignUserHelper.buildUserRequest(PASSWORD).username(username).roles(List.of(roleId)));
+        return FineractFeignClientHelper.createNewFineractFeignClient(username, PASSWORD);
+    }
+
+    private static PostGLAccountsSyncRequest syncRequest(final String reference, final String glCode, final String name) {
+        return new PostGLAccountsSyncRequest().externalReference(reference).glCode(glCode).name(name).type(GLAccountType.ASSET.getValue())
+                .usage(1).manualEntriesAllowed(true);
+    }
+
+    private static String uniqueReference() {
+        return Utils.uniqueRandomStringGenerator("GL-", 8);
+    }
+
+    private static String uniqueGlCode() {
+        return Utils.uniqueRandomStringGenerator("", 10);
+    }
+}
