+import org.apache.fineract.accounting.glaccount.command.GLAccountCommand;
+import org.apache.fineract.accounting.glaccount.domain.GLAccount;
+
+/**
+ * Decides whether a GL account sync request carries the same details as the account already stored under its external
+ * reference.
+ */
+public final class GLAccountExternalReferenceMatcher {
+
+    private GLAccountExternalReferenceMatcher() {}
+
+    public static boolean matches(final GLAccount existing, final GLAccountCommand request) {
+        final Long existingParentId = existing.getParent() == null ? null : existing.getParent().getId();
+        final Long existingTagId = existing.getTagId() == null ? null : existing.getTagId().getId();
+        return Objects.equals(existing.getGlCode(), request.glCode()) //
+                && Objects.equals(existing.getName(), request.name()) //
+                && Objects.equals(existing.getType(), request.type()) //
+                && Objects.equals(existing.getUsage(), request.usage()) //
+                && Objects.equals(existingParentId, request.parentId()) //
+                && Objects.equals(existingTagId, request.tagId()) //
+                && existing.isManualEntriesAllowed() == Boolean.TRUE.equals(request.manualEntriesAllowed()) //
+                && StringUtils.defaultString(existing.getDescription()).equals(StringUtils.defaultString(request.description()));
+    }
+}
