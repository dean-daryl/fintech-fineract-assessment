# Copy to .env (git-ignored) and change the values: cp .env.example .env

# PostgreSQL superuser (db container only)
POSTGRES_PASSWORD=change-me-postgres

# Per-service database logins (created by scripts/db-init/01-databases.sh)
FINERACT_DB_PASSWORD=change-me-fineract
ERP_DB_PASSWORD=change-me-erp
INTEGRATION_DB_PASSWORD=change-me-integration

# Fineract master password (encrypts tenant connection secrets)
FINERACT_DEFAULT_MASTER_PASSWORD=change-me-master
