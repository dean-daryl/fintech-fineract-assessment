+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.apache.fineract.infrastructure.core.exception.AbstractPlatformDomainRuleException;
+
+/**
+ * Thrown by GL account sync when the external reference or GL code is already used with different details. Mapped to
+ * HTTP 409 by {@link GLAccountExternalReferenceConflictExceptionMapper}.
+ */
+public final class GLAccountExternalReferenceConflictException extends AbstractPlatformDomainRuleException {
+
+    private GLAccountExternalReferenceConflictException(final String globalisationMessageCode, final String defaultUserMessage,
+            final Object... defaultUserMessageArgs) {
+        super(globalisationMessageCode, defaultUserMessage, defaultUserMessageArgs);
+    }
+
+    public static GLAccountExternalReferenceConflictException differentPayload(final String externalReference) {
+        return new GLAccountExternalReferenceConflictException("error.msg.glaccount.external.reference.conflict",
+                "General Ledger Account with external reference " + externalReference + " already exists with different details",
+                externalReference);
+    }
+
+    public static GLAccountExternalReferenceConflictException glCodeInUse(final String externalReference, final String glCode) {
+        return new GLAccountExternalReferenceConflictException("error.msg.glaccount.glcode.conflict",
+                "GL code " + glCode + " is already used by another General Ledger Account than external reference " + externalReference,
+                glCode, externalReference);
+    }
+}
