+        account.setId(42L);
+        return account;
+    }
+
+    @Test
+    void sameReferenceAndPayloadReturnsExistingAccount() {
+        when(glAccountRepository.findOneByExternalReference(REFERENCE)).thenReturn(Optional.of(stored("Loan Receivable")));
+
+        final CommandProcessingResult result = service.syncGLAccount(command);
+
+        assertEquals(42L, result.getResourceId());
+        verify(glAccountRepository, never()).saveAndFlush(any());
+    }
