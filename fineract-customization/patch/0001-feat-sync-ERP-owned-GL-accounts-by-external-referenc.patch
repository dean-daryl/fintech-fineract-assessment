+    @Test
+    void sameReferenceWithDifferentPayloadConflicts() {
+        when(glAccountRepository.findOneByExternalReference(REFERENCE)).thenReturn(Optional.of(stored("Other name")));
+
+        assertThrows(GLAccountExternalReferenceConflictException.class, () -> service.syncGLAccount(command));
+        verify(glAccountRepository, never()).saveAndFlush(any());
