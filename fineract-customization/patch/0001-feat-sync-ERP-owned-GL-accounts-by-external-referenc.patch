+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.springframework.dao.ConcurrencyFailureException;
+
+/**
+ * Thrown when a concurrent GL account sync inserted the same external reference or GL code first. Being a
+ * {@link ConcurrencyFailureException}, the command is retried in a new transaction, where the sync finds the committed
+ * account and applies the same-payload or conflict rule.
+ */
+public class GLAccountExternalReferenceConcurrentSyncException extends ConcurrencyFailureException {
+
+    public GLAccountExternalReferenceConcurrentSyncException(final String externalReference, final Throwable cause) {
+        super("Concurrent sync of General Ledger Account with external reference " + externalReference, cause);
+    }
+}
