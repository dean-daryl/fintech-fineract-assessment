+package org.apache.fineract.accounting.glaccount.service;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.apache.fineract.accounting.glaccount.command.GLAccountCommand;
+import org.apache.fineract.accounting.glaccount.domain.GLAccount;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class GLAccountExternalReferenceMatcherTest {
+
+    private static final String REFERENCE = "GL-1200";
+
+    private GLAccount existing;
+
+    @BeforeEach
+    void setUp() {
+        existing = new GLAccount().setGlCode("1200").setName("Loan Receivable").setType(1).setUsage(1).setManualEntriesAllowed(true)
+                .setExternalReference(REFERENCE);
+    }
+
+    private static GLAccountCommand request(String glCode, String name, Integer type, Integer usage, Long parentId,
+            Boolean manualEntriesAllowed, String description) {
+        return new GLAccountCommand(null, name, parentId, glCode, null, manualEntriesAllowed, type, usage, description, null, REFERENCE);
+    }
+
+    @Test
+    void identicalPayloadMatches() {
+        assertTrue(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, null, true, null)));
+    }
+
+    @Test
+    void missingAndEmptyDescriptionAreTheSame() {
+        assertTrue(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, null, true, "")));
+    }
+
+    @Test
+    void differentNameDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loans Receivable", 1, 1, null, true, null)));
+    }
+
+    @Test
+    void differentGlCodeDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1201", "Loan Receivable", 1, 1, null, true, null)));
+    }
+
+    @Test
+    void differentTypeDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 2, 1, null, true, null)));
+    }
+
+    @Test
+    void differentUsageDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 2, null, true, null)));
+    }
+
+    @Test
+    void differentManualEntriesAllowedDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, null, false, null)));
+    }
+
+    @Test
+    void differentDescriptionDoesNotMatch() {
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, null, true, "Other")));
+    }
+
+    @Test
+    void differentParentDoesNotMatch() {
+        final GLAccount parent = new GLAccount();
+        parent.setId(7L);
+        existing.setParent(parent);
+
+        assertTrue(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, 7L, true, null)));
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, 8L, true, null)));
+        assertFalse(GLAccountExternalReferenceMatcher.matches(existing, request("1200", "Loan Receivable", 1, 1, null, true, null)));
+    }
+}
